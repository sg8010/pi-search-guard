{
  "name": "pi-search-guard",
  "version": "0.1.0",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "description": "Pi extensions that make search safe: bounded `find` calls are rewritten to bfs, recursive or directory `grep` is refused in favour of ripgrep, and unbounded scans are blocked before they run",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/find-guard.ts",
      "./extensions/grep-guard.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/find-guard.test.ts test/grep-guard.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^26.6.5",
    "typescript": "5.9.3"
  }
}
